# Nenhuma variável é obrigatória. Copie para .env.local se quiser sobrescrever.

# URL pública do site (metadados Open Graph). Na Vercel use a URL de produção.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base do Monaco Editor (pasta "vs"). Por padrão o editor é servido de /monaco/vs, copiado
# de node_modules no postinstall/prebuild. Defina para usar um CDN ou mirror próprio.
# NEXT_PUBLIC_MONACO_BASE_URL=https://cdn.jsdelivr.net/npm/monaco-editor@0.57.0/min/vs

# Placar de líderes (Firebase). Sem estas variáveis o placar fica desligado e o jogo funciona normalmente.
# Valores em: Console do Firebase → Configurações do projeto → Seus apps → Web. Não são segredos
# (as regras de firestore.rules protegem os dados). Na Vercel, cadastre-as em Settings → Environment Variables.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
