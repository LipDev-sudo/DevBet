rules_version = '2';

// Placar do DEVBet. Qualquer pessoa lê o ranking; só o próprio jogador logado grava o próprio registro,
// com campos e limites fixos. O registro acompanha a run atual (pode subir ou descer a cada nova run). Só o administrador apaga.
service cloud.firestore {
  match /databases/{database}/documents {
    function validEntry(d) {
      return d.keys().hasOnly(['nickname', 'score', 'bestHand', 'blindsCleared', 'won', 'updatedAt'])
        && d.nickname is string && d.nickname.size() >= 2 && d.nickname.size() <= 16
        && d.score is int && d.score > 0 && d.score <= 200000
        && d.bestHand is int && d.bestHand >= 0 && d.bestHand <= d.score
        && d.blindsCleared is int && d.blindsCleared >= 0 && d.blindsCleared <= 10
        && d.won is bool
        && d.updatedAt == request.time;
    }

    // Só quem está logado (inclusive o login anônimo, sem janela do Google) grava, e só o próprio registro.
    // Para exigir Google de volta: && request.auth.token.firebase.sign_in_provider == 'google.com'.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Administrador (moderação): a conta de e-mail e senha criada no console do Firebase.
    // Troque COLE_AQUI_O_UID_DO_ADMIN pelo UID dela (Authentication → Users → coluna "UID do usuário").
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'COLE_AQUI_O_UID_DO_ADMIN';
    }

    // Jogador bloqueado pelo administrador: não grava mais no placar.
    function isBanned(uid) {
      return exists(/databases/$(database)/documents/banned/$(uid));
    }

    match /leaderboard/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && !isBanned(uid) && validEntry(request.resource.data);
      allow update: if isOwner(uid)
        && !isBanned(uid)
        && validEntry(request.resource.data);
      allow delete: if isAdmin();
    }

    // Respostas das perguntas: cada jogador grava só as próprias marcações; quem lê é o administrador.
    match /answers/{answerId} {
      allow read: if isAdmin();
      // O jogo lê o próprio documento antes de somar a marcação nova (transação).
      allow get: if request.auth != null && answerId.matches('.*__' + request.auth.uid);
      allow create, update: if request.auth != null
        && !isBanned(request.auth.uid)
        && request.resource.data.keys().hasOnly(['questionId', 'uid', 'nickname', 'picks', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.questionId is string
        && request.resource.data.questionId.size() <= 40
        && answerId == request.resource.data.questionId + '__' + request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 16
        && request.resource.data.picks is list
        && request.resource.data.picks.size() >= 1
        && request.resource.data.picks.size() <= 60
        && request.resource.data.picks.hasOnly([0, 1, 2, 3])
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /banned/{uid} {
      allow read, write: if isAdmin();
    }
  }
}
