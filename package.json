{
  "name": "devbet",
  "version": "0.1.0",
  "private": true,
  "description": "Programming roguelike where you bet on your coding skills.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "postinstall": "node scripts/copy-assets.mjs",
    "prebuild": "node scripts/copy-assets.mjs",
    "predev": "node scripts/copy-assets.mjs",
    "e2e:tutorial": "node e2e/tut.js",
    "e2e:tutorial:mobile": "node e2e/tutmob.js",
    "e2e:edge": "node e2e/edge.js",
    "e2e:integrity": "node e2e/hard5.js",
    "e2e:tabs": "node e2e/audit6.js",
    "e2e:screens": "node e2e/screens.js",
    "e2e:keyboard": "node e2e/keyboard.js",
    "e2e:persist": "node e2e/persist.js",
    "e2e:sandbox": "node e2e/sandbox.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.57.0",
    "next": "^16.4.0",
    "pyodide": "^314.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "playwright-core": "^1.56.1",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vitest": "^5.0.3"
  }
}
